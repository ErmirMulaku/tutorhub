# Copy to .env (gitignored) and fill in. Never commit real secrets.

# HTTP port the API listens on.
PORT=4000

# PostgreSQL connection string used by Prisma (added in Phase 2 / unit 2).
DATABASE_URL=postgresql://tutorhub:tutorhub@localhost:5432/tutorhub?schema=public

# Secret for signing JWTs (dev-login). Use a long random value in real deploys.
JWT_SECRET=dev-only-change-me

# Demo email-verification shortcut. When set, this exact code verifies ANY email
# during signup (student or tutor) — it bypasses real verification. Off (null)
# unless set. Use it for a public demo where email delivery isn't wired yet: the
# signup UI shows the code and tells users it's a shortcut. Unset it once real
# email (a verified sending domain) is live. Never reuse your JWT secret here.
DEMO_VERIFICATION_CODE=

# Social sign-in audiences. When set, googleSignin/appleSignin verify the
# provider ID token against the provider JWKS with this client id as audience.
# Leave unset to disable real social sign-in (the mutations return a
# "not configured" error and the storefront uses its simulated fallback).
# GOOGLE_CLIENT_ID matches NEXT_PUBLIC_GOOGLE_CLIENT_ID; APPLE_CLIENT_ID is the
# Apple Services ID.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Address the gRPC microservice binds to (SPEC §9).
GRPC_URL=0.0.0.0:50051

# The seeded student the assistant books as (no end-user auth yet).
DEMO_STUDENT_EMAIL=sara@example.com

# Stripe (test mode) — powers the real payment loop: students are charged via
# PaymentIntents, funds transfer to each tutor's Connect (Express) account, then
# payouts settle. Leave STRIPE_SECRET_KEY unset to disable payments (the app
# still boots on seeded data). Use TEST keys (sk_test_… / whsec_…) only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Base URL the dashboard is served from — used to build Connect onboarding
# return/refresh redirect links.
DASHBOARD_URL=http://localhost:3100

# AI gateway + RAG help center (docs/AI_GATEWAY_RAG_SPEC.md).

# Redis: request-rate / token-budget limits and response caching.
REDIS_URL=redis://localhost:6379

# AWS region to call Bedrock + S3 Vectors in. Pick one where the chosen Claude
# model, Titan Text Embeddings V2, and S3 Vectors are all available.
# Required — the app fails fast on boot if this is unset (no us-east-1 default).
AWS_REGION=

# Bedrock model ids (or inference-profile ids, e.g. eu.anthropic...). Verify
# with `aws bedrock list-foundation-models` / `list-inference-profiles`.
BEDROCK_PRIMARY_MODEL_ID=
BEDROCK_FALLBACK_MODEL_ID=
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# S3 Vectors bucket + index backing the help-center RAG store (Block 0 setup).
S3_VECTOR_BUCKET=tutorhub-help-vectors
S3_VECTOR_INDEX=help-articles-v1

# "I don't know" guard for help_question: if the closest chunk's distance is
# worse (larger) than this, answer without calling the LLM. Calibrate with
# `npm run rag:eval` (Block 10).
RAG_MAX_DISTANCE=0.6

# Per-principal limits enforced by RateLimitService.
AI_RATE_LIMIT_PER_MIN=20
AI_DAILY_TOKEN_BUDGET=50000

# $ per 1M tokens, by model id: {"<modelId>":{"in":0.8,"out":4}}. Unknown
# model ids price at $0 (and log a warning) rather than failing the request.
AI_MODEL_PRICES_JSON=

# Booking events (docs/FRESHA_DEPTH_SPEC.md Block 4). Comma-separated Kafka
# brokers, e.g. localhost:9092 for `docker compose up -d redpanda`. Leave
# empty to run without Kafka: booking changes still write outbox rows, but
# nothing publishes them and notifications use the in-process fallback.
KAFKA_BROKERS=

# Kill switch for the outbox relay. "false" stops publishing to Kafka without
# a deploy; events keep accumulating in the OutboxEvent table and go out once
# it's back on.
OUTBOX_PUBLISH_ENABLED=true
