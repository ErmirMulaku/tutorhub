// TutorHub domain model (SPEC §8). One source of truth for Postgres; the
// generated client is consumed by the NestJS service layer.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  LESSON_REMINDER
  REVIEW_PROMPT
  GIFT_RECEIVED
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

enum PayoutSchedule {
  DAILY
  WEEKLY
  MONTHLY
}

model Tutor {
  id           String     @id @default(uuid())
  name         String
  bio          String?
  headline     String? // one-line pitch shown on cards/profile
  about        String? // long-form profile/settings bio (distinct from short bio)
  timezone     String // IANA, e.g. "Europe/Belgrade"
  hourlyCents  Int
  workingHours Json // WorkingHours[] — [{ day, start, end }]
  isActive     Boolean    @default(true)
  avatarColor  String? // UI avatar palette key (teal, amber, …)
  languages    String[]   @default([])
  badges       String[]   @default([]) // e.g. "Top rated", "Fast responder", "Verified"
  responseTime String? // human label, e.g. "~1 hr"
  totalLessons Int        @default(0)
  // Review aggregates kept on the tutor, so discover can filter and sort by
  // rating in SQL and return one page (instead of loading every tutor and
  // averaging in Node). Updated atomically with each new review.
  ratingSum    Int        @default(0)
  ratingCount  Int        @default(0)
  ratingAvg    Float?

  // Tutor identity (dashboard auth). Nullable so seeded tutors and dev-login work
  // without credentials; student auth is unaffected.
  email         String? @unique
  passwordHash  String?
  emailVerified Boolean @default(false)

  // Stripe Connect (Express) account for receiving payouts. Null until the tutor
  // completes onboarding from the dashboard.
  stripeConnectAccountId String? @unique
  stripePayoutsEnabled   Boolean @default(false)

  // Tutor-side notification preferences (settings → notifications).
  notifyBookings  Boolean @default(true)
  notifyReminders Boolean @default(true)
  notifyMessages  Boolean @default(true)
  notifyPayouts   Boolean @default(true)
  notifyTips      Boolean @default(false)

  // Booking rules (availability module).
  bufferMinutes    Int            @default(15)
  minNoticeHours   Int            @default(4)
  maxLessonsPerDay Int            @default(6)
  payoutSchedule   PayoutSchedule @default(WEEKLY)
  payoutMethod     String? // human label, e.g. "Visa •••• 4242"

  subjects    Subject[]
  bookings    Booking[]
  reviews     Review[]
  favoritedBy Favorite[]
  services      Service[]
  timeOff       TimeOff[]
  conversations Conversation[]
  payouts       Payout[]
  promotions    Promotion[]
  referral      Referral?
  giftCards     GiftCard[]
  emailCodes    TutorEmailVerification[]
  createdAt     DateTime       @default(now())
}

model TutorEmailVerification {
  id        String   @id @default(uuid())
  tutor     Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tutorId   String
  code      String // 6-digit numeric code
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tutorId])
}

enum PromotionState {
  ACTIVE
  SCHEDULED
  ENDED
}

enum DiscountType {
  PERCENT
  FIXED
}

model Promotion {
  id            String         @id @default(uuid())
  tutor         Tutor          @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tutorId       String
  name          String
  code          String         @unique
  discountType  DiscountType   @default(PERCENT)
  discountValue Int // percent (0–100) or cents, per discountType
  state         PromotionState @default(SCHEDULED)
  startsAt      DateTime?
  expiresAt     DateTime?
  redemptions   Int            @default(0)
  createdAt     DateTime       @default(now())

  @@index([tutorId])
}

model Referral {
  id            String   @id @default(uuid())
  tutor         Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tutorId       String   @unique
  creditCents   Int      @default(1500)
  referredCount Int      @default(0)
  issuedCents   Int      @default(0)
  createdAt     DateTime @default(now())
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

// A withdrawal of cleared earnings to the tutor's payout method.
model Payout {
  id          String       @id @default(uuid())
  tutor       Tutor        @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tutorId     String
  amountCents Int
  status      PayoutStatus @default(PAID)
  method      String?
  payments    Payment[]
  // Stripe Transfer (platform → connected account) and the resulting Payout.
  stripeTransferId String? @unique
  stripePayoutId   String? @unique
  createdAt   DateTime     @default(now())

  @@index([tutorId, createdAt])
}

enum ServiceType {
  ONE_ON_ONE
  GROUP
  PACKAGE
}

// A priced offering on the tutor's catalog (1:1, group, or a package of lessons).
model Service {
  id           String      @id @default(uuid())
  tutor        Tutor       @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tutorId      String
  subject      Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectId    String?
  name         String
  type         ServiceType @default(ONE_ON_ONE)
  level        Level
  description  String?
  priceCents   Int
  durationMin  Int         @default(60)
  lessonsCount Int         @default(1) // > 1 for PACKAGE
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  @@index([tutorId])
}

// A range the tutor is unavailable (holiday, etc.) — shown on the availability screen.
model TimeOff {
  id        String   @id @default(uuid())
  tutor     Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tutorId   String
  label     String // e.g. "🏖 Holiday"
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  @@index([tutorId])
}

model Subject {
  id       String    @id @default(uuid())
  name     String
  level    Level
  tutor    Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tutorId  String
  bookings Booking[]
  services Service[]
}

enum SenderKind {
  TUTOR
  STUDENT
}

// A 1:1 conversation between a tutor and a student.
model Conversation {
  id            String    @id @default(uuid())
  tutor         Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tutorId       String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId     String
  subjectName   String? // denormalised header label, e.g. "Mathematics student"
  lastMessageAt DateTime  @default(now())
  messages      Message[]
  createdAt     DateTime  @default(now())

  @@unique([tutorId, studentId])
  @@index([tutorId, lastMessageAt])
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  senderKind     SenderKind
  body           String
  readByTutor    Boolean      @default(false)
  readByStudent  Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Student {
  id           String          @id @default(uuid())
  fullName     String
  email        String          @unique
  passwordHash String? // null for seeded/dev students (dev-login)
  phone        String?
  avatarColor  String? // UI avatar palette key
  walletCents  Int             @default(0)
  // Stripe customer for charging saved cards. Null until first card is added.
  stripeCustomerId String?      @unique
  // Notification preferences (account → notifications screen).
  notifyEmail     Boolean @default(true)
  notifySms       Boolean @default(false)
  notifyReminders Boolean @default(true)
  notifyPromos    Boolean @default(false)
  twoFactorEnabled Boolean @default(false)
  emailVerified   Boolean @default(false)
  bookings        Booking[]
  favorites       Favorite[]
  giftCards       GiftCard[]
  paymentMethods  PaymentMethod[]
  notifications   Notification[]
  emailCodes      EmailVerification[]
  oauthAccounts   OAuthAccount[]
  conversations   Conversation[]
  createdAt       DateTime        @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  type      NotificationType
  // Denormalised params the client renders into localised title/body templates.
  actorName String? // tutor or gift sender, e.g. "Priya", "Mum"
  detail    String? // subject or amount, e.g. "Computer Science", "$50"
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([studentId, createdAt])
}

model EmailVerification {
  id        String   @id @default(uuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  code      String // 6-digit numeric code
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([studentId])
}

model OAuthAccount {
  id             String        @id @default(uuid())
  provider       OAuthProvider
  providerUserId String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      String
  createdAt      DateTime      @default(now())

  @@unique([provider, providerUserId])
}

model Favorite {
  id        String   @id @default(uuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  tutor     Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tutorId   String
  createdAt DateTime @default(now())

  @@unique([studentId, tutorId])
}

model GiftCard {
  id          String   @id @default(uuid())
  code        String   @unique
  amountCents Int
  balanceCents Int
  design      Int      @default(0) // index into the UI design palette
  fromName    String?
  toName      String?
  message     String?
  // The student who currently owns/redeemed the card (null = unredeemed).
  owner       Student? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId     String?
  // Optional tutor a gift card was sold under (marketing → gift cards sold).
  tutor       Tutor?   @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  tutorId     String?
  createdAt   DateTime @default(now())
}

model PaymentMethod {
  id        String   @id @default(uuid())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  brand     String // "visa", "mastercard", …
  last4     String
  expMonth  Int
  expYear   Int
  createdAt DateTime @default(now())
}

enum BookingSource {
  WEB
  MOBILE
  DASHBOARD
  ASSISTANT
}

model Booking {
  id        String        @id @default(uuid())
  tutor     Tutor         @relation(fields: [tutorId], references: [id])
  tutorId   String
  student   Student       @relation(fields: [studentId], references: [id])
  studentId String
  subject   Subject       @relation(fields: [subjectId], references: [id])
  subjectId String
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(PENDING)
  // Optimistic lock: every write bumps it, and edits that change more than
  // the status only apply `where: { id, version }` — a stale read loses.
  version   Int           @default(0)
  // Where the booking was made. Added with expand → backfill → contract
  // (FRESHA_DEPTH_SPEC Block 6): nullable for now; the backfill fills old
  // rows; a later migration makes it NOT NULL without a long table lock.
  source    BookingSource?
  payment   Payment?
  review    Review?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([tutorId, startTime])
  // (studentId, startTime, id): the exact sort order of myBookingsConnection,
  // so a page is a plain index range scan with no extra sort step. Equality
  // column first, then the sort columns, `id` last as the tie-breaker.
  @@index([studentId, startTime, id])
  // Tutor dashboard: bookings for one tutor with one status, newest first.
  // Equality columns (tutorId, status) lead; the sort column (createdAt)
  // trails, so the index supplies the ORDER BY and no Sort node is needed.
  @@index([tutorId, status, createdAt])
}

model Review {
  id        String    @id @default(uuid())
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String    @unique
  tutor     Tutor     @relation(fields: [tutorId], references: [id])
  tutorId   String
  rating    Int // 1–5
  comment   String?
  reply     String? // the tutor's public response
  repliedAt DateTime?
  createdAt DateTime  @default(now())
}

model Payment {
  id          String        @id @default(uuid())
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId   String        @unique
  amountCents Int
  feeCents    Int           @default(0) // platform fee; net = amountCents - feeCents
  status      PaymentStatus @default(PENDING)
  // Denormalised for earnings aggregation (cheaper than joining through booking).
  tutorId     String?
  payout      Payout?       @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  payoutId    String?
  // Stripe PaymentIntent that charged the student for this booking.
  stripePaymentIntentId String? @unique

  @@index([tutorId, status])
}

// AI gateway audit log (docs/AI_GATEWAY_RAG_SPEC.md, Block 8). principalId is
// a student or tutor id depending on principalKind, never a Prisma relation,
// since a single principal column can't point at two different tables.
// Never store prompt or answer text here — tokens/cost only, no PII.
model AiUsageLog {
  id            String   @id @default(uuid())
  requestId     String
  principalKind String
  principalId   String
  task          String
  model         String?
  promptVersion Int
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  costUsd       Decimal  @default(0) @db.Decimal(10, 6)
  latencyMs     Int
  cacheHit      Boolean  @default(false)
  status        String // ok | denied | rate_limited | error
  createdAt     DateTime @default(now())

  @@index([principalKind, principalId, createdAt])
  @@index([task, createdAt])
}

// A client-chosen key that makes "create a booking" safe to retry
// (FRESHA_DEPTH_SPEC Block 3a). The first request inserts the key, does the
// work and saves its response in ONE transaction; a retry with the same key
// gets that saved response back instead of creating a second booking.
model IdempotencyKey {
  key          String   @id
  // Who sent it (e.g. "student:<id>"); a key is never shared across callers.
  principal    String
  // sha256 of the request body; same key + different body = client bug (422).
  requestHash  String
  responseJson Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

// Stripe event ids we have already applied (FRESHA_DEPTH_SPEC Block 3b).
// Stripe delivers webhooks at least once, so the same event can arrive
// twice; inserting its id in the same transaction as the change makes the
// second delivery a no-op.
model ProcessedStripeEvent {
  eventId     String   @id
  type        String
  processedAt DateTime @default(now())
}

// Transactional outbox (FRESHA_DEPTH_SPEC Block 4). Every booking change
// inserts one row here IN THE SAME TRANSACTION as the change, so "the booking
// changed" and "an event will be published" are always both true or both
// false. A relay later publishes unpublished rows to Kafka and stamps them.
// A partial index on unpublished rows lives in the migration SQL (Prisma
// can't express `WHERE "publishedAt" IS NULL`).
model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String
  aggregateId   String
  type          String
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?
}

// Events a consumer has already handled (idempotent consumer). Kafka delivers
// at least once, so the same event can arrive twice; inserting (consumer,
// eventId) in the same transaction as the side effect makes a repeat a no-op.
model ProcessedEvent {
  consumer    String
  eventId     String
  processedAt DateTime @default(now())

  @@id([consumer, eventId])
}

// Feature flags (FRESHA_DEPTH_SPEC Block 7): turn code paths on for some
// users, or off for everyone, without a deploy. Read via FeatureFlagService
// (cached 30 s per instance); changed with scripts/flag.ts.
model FeatureFlag {
  key            String   @id
  // Master switch: false = off for everyone, whatever the rest says.
  enabled        Boolean  @default(false)
  // 0–100: share of subjects (e.g. students) it's on for, by a stable hash.
  rolloutPercent Int      @default(0)
  // Subject ids it's always on for (testers, internal accounts).
  allowList      String[] @default([])
  updatedAt      DateTime @updatedAt
}
