{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && CYPRESS_INSTALL_BINARY=0 npm ci --workspace=@ermulaku/dashboard-reviews --include-workspace-root",
  "buildCommand": "cd ../.. && node -v && npx nx build @ermulaku/dashboard-reviews",
  "outputDirectory": "dist/dashboard-reviews/browser",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(remoteEntry|importmap)\\.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
