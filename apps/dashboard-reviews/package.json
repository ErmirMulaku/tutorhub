{
  "name": "@ermulaku/dashboard-reviews",
  "version": "0.0.0",
  "private": true,
  "description": "TutorHub tutor dashboard — the Reviews page as a Native Federation remote, loaded by apps/dashboard-ng at runtime and deployed on its own.",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --port 3101",
    "build": "ng build --define \"API_URL='${API_URL:-http://localhost:4000}'\"",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint src",
    "test": "ng test --no-watch --no-progress --browsers=${KARMA_BROWSER:-ChromeHeadless}",
    "test:watch": "ng test"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@ermulaku/dashboard-kit": "*",
    "@ermulaku/types": "*",
    "@ngrx/store": "22.0.1",
    "es-module-shims": "2.8.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "22.2.4",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@softarc/native-federation-orchestrator": "4.9.0",
    "@types/jasmine": "6.0.0",
    "istanbul-lib-instrument": "6.0.3",
    "jasmine-core": "6.3.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.3.0",
    "zone.js": "0.16.3"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          {
            "env": "API_URL"
          }
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^default"
        ]
      }
    }
  }
}
