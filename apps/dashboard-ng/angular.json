{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "schematics": {
    "@schematics/angular:application": {
      "testRunner": "karma"
    },
    "@schematics/angular:library": {
      "testRunner": "karma"
    }
  },
  "projects": {
    "dashboard-ng": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "th",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "cacheExternalArtifacts": true,
            "tsConfig": "tsconfig.federation.json"
          },
          "configurations": {
            "production": {
              "target": "dashboard-ng:esbuild:production"
            },
            "development": {
              "target": "dashboard-ng:esbuild:development",
              "dev": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "dashboard-ng:serve-original:development",
            "tsConfig": "tsconfig.federation.json",
            "outputPath": "dist/dashboard-ng-dev",
            "rebuildDelay": 500,
            "cacheExternalArtifacts": true,
            "dev": true,
            "devServer": true,
            "port": 0
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "karma",
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": "dashboard-ng:esbuild:test",
            "include": [
              "test-setup.ts",
              "**/*.spec.ts",
              "../../../packages/dashboard-kit/src/**/*.spec.ts"
            ]
          }
        },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.scss"],
            "define": {
              "API_URL": "'http://localhost:4000'"
            },
            "polyfills": ["es-module-shims"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "380kB",
                  "maximumError": "420kB"
                },
                {
                  "type": "allScript",
                  "maximumWarning": "600kB",
                  "maximumError": "700kB"
                },
                {
                  "type": "bundle",
                  "name": "shell-routes",
                  "maximumWarning": "85kB",
                  "maximumError": "100kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/dev-tools.ts",
                  "with": "src/environments/dev-tools.development.ts"
                }
              ]
            },
            "test": {
              "optimization": false,
              "sourceMap": true,
              "polyfills": ["zone.js"]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "dashboard-ng:esbuild:production"
            },
            "development": {
              "buildTarget": "dashboard-ng:esbuild:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 3100
          }
        }
      }
    }
  }
}
